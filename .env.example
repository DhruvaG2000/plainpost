# Gmail defaults to IMAP/SMTP: run npm run config:init and edit the home config.
# These client settings are only for the optional Google OAuth mode.
# For OAuth, enable the Gmail API and register a Web application client with
# exactly http://localhost:4819/auth/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PORT=4819
APP_URL=http://localhost:4819
# Default: ./data. Contains the encryption key and encrypted token vault.
# scripts/start-linux.sh (also start-wsl.sh) and the generated boot service
# default to ${XDG_DATA_HOME:-$HOME/.local/share}/plainpost in Linux.
# Export DATA_DIR in your shell before starting or generating the service
# to override their location; that setting takes precedence over this file.
# Protect this directory with your OS user permissions and disk encryption.
# DATA_DIR=./data

# Optional outgoing b4 relay. Verify the sender and signing key with the relay first.
# B4_RELAY_URL=https://lkml.kernel.org/_b4_submit
# B4_RELAY_FROM="Your Name <you@example.org>"
# PATATT_PATH=/absolute/path/to/patatt
